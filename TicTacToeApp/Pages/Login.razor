@page "/"
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="container mt-6">
    <div class="columns is-centered">
        <div class="column is-half">
            <div class="box has-text-centered">
                <h1 class="title">Добро пожаловать 🎮</h1>
                <p class="subtitle">Введите своё имя, чтобы начать игру</p>

                <div class="field">
                    <div class="control">
                        <input class="input is-medium" type="text" placeholder="Ваше имя"
                               @bind="playerName" />
                    </div>
                </div>

                <div class="buttons is-centered mt-4">
                    <button class="button is-primary is-medium" @onclick="DoLogin">
                        Войти
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string playerName;

    private async Task DoLogin()
    {
        if (!string.IsNullOrWhiteSpace(playerName))
        {
            // сохраняем имя в localStorage
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "playerName", playerName);

            // переходим на страницу игр
            Navigation.NavigateTo("/game");
        }
    }
}
